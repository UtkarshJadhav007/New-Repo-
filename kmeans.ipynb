   "source": [
    "from sklearn.cluster import KMeans\n",
    "\n",
    "# Data \n",
    "X = [[1,1], [2,2], [8,8], [9,9]]\n",
    "\n",
    "# Create K-Means Model \n",
    "model = KMeans(n_clusters=2, random_state=42, n_init=10)\n",
    "\n",
    "# Train Model \n",
    "model.fit(X)\n",
    "\n",
    "# Print cluster labels \n",
    "print(\"Clusters:\", model.labels_)\n"
   ]
  },
