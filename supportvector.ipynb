   "source": [
    "from sklearn.svm import SVC\n",
    "\n",
    "# Data\n",
    "X = [[1], [2], [3], [4]]\n",
    "y = [0, 0, 1, 1]\n",
    "\n",
    "# Create SVM model\n",
    "model = SVC(kernel='linear')\n",
    "\n",
    "# Train model\n",
    "model.fit(X, y)\n",
    "\n",
    "# Predict\n",
    "print(model.predict([[3]]))"
   ]
  }
 ],
